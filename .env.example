# Copy to .env (never commit it) or set these in your shell / Streamlit secrets.
# All are optional: ProofPilot runs without any key using its heuristic policy.

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Groq (free tier: https://console.groq.com/keys)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, ...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Local Ollama server
# OLLAMA_MODEL=llama3.1

# Raises GitHub search rate limits (optional)
# GITHUB_TOKEN=

# Where long-term memory is stored (default: ~/.proofpilot)
# PROOFPILOT_HOME=
